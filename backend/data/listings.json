router.post("/", verifyToken, (req, res) => {

    const {
        title,
        rent,
        location,
        image,
        description
    } = req.body;

    db.run(
        `
        INSERT INTO listings
        (
            title,
            rent,
            location,
            image,
            description
        )
        VALUES (?, ?, ?, ?, ?)
        `,
        [
            title,
            rent,
            location,
            image,
            description
        ],
        function(err){

            if(err){
                return res.status(500)
                .json(err);
            }

            res.status(201).json({
                id: this.lastID,
                title,
                rent,
                location,
                image,
                description
            });
        }
    );
});